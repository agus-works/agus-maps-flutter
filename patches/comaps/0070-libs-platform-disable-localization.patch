From 98c871c82869408619b0682255758807e3248386 Mon Sep 17 00:00:00 2001
From: Antigravity <agent@example.com>
Date: Mon, 02 Feb 2026 20:15:00 +0800
Subject: [PATCH] libs/platform: disable default localization

Disable default localization implementations in platform library
to avoid duplicate symbol errors when linking with AgusLocalizationBridge
in the Flutter plugin.
---
 libs/platform/localization.cpp | 4 ++++
 libs/platform/localization.mm  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/libs/platform/localization.cpp b/libs/platform/localization.cpp
index 738419e..3e5621a 100644
--- a/libs/platform/localization.cpp
+++ b/libs/platform/localization.cpp
@@ -44,6 +44,8 @@ LocalizedUnits const & GetLocalizedUnits(measurement_utils::Units units, Measure
 }
 }  // namespace
 
+#if 0 // Disabled for Flutter plugin (handled by AgusLocalizationBridge)
+
 LocalizedUnits const & GetLocalizedDistanceUnits()
 {
   return GetLocalizedUnits(measurement_utils::GetMeasurementUnits(), MeasurementType::Distance);
@@ -64,4 +66,6 @@ std::string const & GetLocalizedSpeedUnits()
 {
   return GetLocalizedSpeedUnits(measurement_utils::GetMeasurementUnits());
 }
+
+#endif // Disabled for Flutter plugin
+
 }  // namespace platform
diff --git a/libs/platform/localization.mm b/libs/platform/localization.mm
index 45a1b2c..9c8d7e6 100644
--- a/libs/platform/localization.mm
+++ b/libs/platform/localization.mm
@@ -6,6 +6,8 @@
 
 namespace platform
 {
+#if 0 // Disabled for Flutter plugin (handled by AgusLocalizationBridge)
+
 std::string GetLocalizedTypeName(std::string const & type)
 {
   auto key = "type." + type;
@@ -45,4 +47,6 @@ std::string GetLocalizedMyPositionBookmarkName()
                                         dateStyle:NSDateFormatterLongStyle
                                         timeStyle:NSDateFormatterShortStyle].UTF8String;
 }
+
+#endif // Disabled for Flutter plugin
+
 }  // namespace platform
